{
	"schemaVersion": 1,
	"id": "${mod_id}",
	"version": "${version}",
	"name": "${mod_name}",
	"description": "${mod_description}",
	"authors": [
		"${mod_authors}"
	],
	"contact": {
		"homepage": "${mod_homepage}",
		"sources": "${mod_sources}"
	},
	"license": "${mod_license}",
	"icon": "${mod_icon}",
	"environment": "*",
	"entrypoints": {
		"main": [
			"net.n1zy.Deepslate"
		],
		"client": [
			"net.n1zy.client.DeepslateClient"
		],
		"fabric-datagen": [
			"net.n1zy.client.DeepslateDataGenerator"
		],
		"modmenu": [
			"net.n1zy.client.config.ModMenuIntegration"
		]
	},
	"mixins": [
		"deepslate.mixins.json",
		{
			"config": "deepslate.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=${fabric_loader}",
		"minecraft": "${minecraft_range}",
		"java": ">=${java_version}",
		"fabric-api": "*",
		"yet_another_config_lib_v3": ">=${yacl_version}",
		"modmenu": ">=${modmenu_version}"
	}
}